# Copy to .env (never commit .env). Read by docker compose; every entry is optional.

# Host port; the workbench is published on 127.0.0.1 only.
ACT_GUI_PORT=8080
# Image name/tag to run or build.
ACT_GUI_IMAGE=act-gui:0.1.0
# gurobipy version installed at build time; match your license's Gurobi major version.
GUROBIPY_VERSION=13.0.0
# Host path of your gurobi.lic, used only with compose.gurobi.yaml.
GUROBI_LICENSE_FILE=
# AI provider key, kept server-side. Never prefix secrets with VITE_.
ANTHROPIC_API_KEY=
